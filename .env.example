# Only needed for scripts (examples/five-percent-sp500). Claude itself connects over OAuth, no key.
# Copy to .env (gitignored) and fill in. Never commit real keys.

# Sequence read-only API key: dashboard -> Agents -> API Keys (READ_ACCOUNTS + READ_TRANSFERS)
SEQUENCE_API_KEY=
# Id of the Invest pod (ask Claude: "what's my Invest pod id?")
SEQUENCE_INVEST_POD_ID=

# Optional: Alpaca *paper* trading keys. Leave empty to only log a dry run.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
INVEST_SYMBOL=SPY
